# Alpaca PAPER credentials for the fresh, dedicated $100,000 hackathon account.
# ARGUS has no live mode; TradingClient is always constructed with paper=True.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# OpenRouter key for the bounded AI arm. Leave empty to run quant-only or replay.
OPENROUTER_API_KEY=

# Where ledgers, snapshots, and exports go (gitignored).
ARGUS_DATA_DIR=runs

# Experiment contract (changing any of these creates a new trial; set ARGUS_TRIAL_ID).
ARGUS_TRIAL_ID=same_information_v1
ARGUS_MODEL=google/gemini-2.5-flash-lite
ARGUS_UNDERLYINGS=SPY,QQQ
ARGUS_DTE_MIN=7
ARGUS_DTE_MAX=21
ARGUS_SPREAD_WIDTH=5
ARGUS_TARGET_DELTA=0.40
# credit verticals: short leg nearest this |delta|; used when RV20-IV wedge <= ARGUS_CREDIT_WEDGE_MAX (IV rich)
ARGUS_TARGET_SHORT_DELTA=0.30
ARGUS_CREDIT_WEDGE_MAX=-0.01
ARGUS_STRUCTURES=bull_call_debit,bear_put_debit,bull_put_credit,bear_call_credit
ARGUS_MAX_SPREAD_PCT=0.08
ARGUS_WEDGE_MIN=-0.10
ARGUS_TREND_MIN=0.005
ARGUS_RISK_CAP_PCT=0.01
ARGUS_START_EQUITY=100000
ARGUS_PROFIT_TARGET=0.5
ARGUS_STOP_LOSS=0.5
# Flatten 16:00 CEST Friday: deadline is 17:00 CEST; leaves 60 min for close retries.
ARGUS_FLATTEN_AT=2026-09-04T14:00:00Z
ARGUS_NO_NEW_MINUTES_BEFORE_FLATTEN=60
ARGUS_AGGREGATE_RISK_CAP_PCT=0.05
ARGUS_MAX_CLOSE_ATTEMPTS=6
ARGUS_OPTIONS_FEED=indicative
# Alpaca charges $0 options commission; this models ORF/CAT regulatory fees per contract per side.
ARGUS_COMMISSION_PER_CONTRACT=0.05
ARGUS_SLIPPAGE_FRAC=0.25
ARGUS_DAILY_AI_BUDGET_USD=2.0
