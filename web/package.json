{
  "name": "argus-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "prototype": "vite --config vite.prototype.config.mjs",
    "dev": "vite --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.json",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
